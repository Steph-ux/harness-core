{
  "name": "harness-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Host-neutral proof and discipline core: immutable observations, evidence-bound tasks, shared types.",
  "exports": {
    ".": "./src/index.ts",
    "./util": "./src/util.ts",
    "./types": "./src/types.ts",
    "./context": "./src/context.ts",
    "./capsule": "./src/capsule.ts",
    "./capture": "./src/capture.ts",
    "./process": "./src/process.ts",
    "./skills": "./src/skills.ts",
    "./store": "./src/store.ts",
    "./tasks": "./src/tasks.ts",
    "./observation-id": "./src/observation-id.ts",
    "./platform-store": "./src/platform-store.ts",
    "./platform-types": "./src/platform-types.ts",
    "./skill-trace": "./src/skill-trace.ts",
    "./engagement-workflow": "./src/engagement-workflow.ts",
    "./tool-registry": "./src/tool-registry.ts",
    "./tool-gap": "./src/tool-gap.ts",
    "./coverage-profiles": "./src/coverage-profiles.ts"
  },
  "scripts": {
    "test": "node test/run.cjs",
    "test:gate": "node scripts/pi-gate.cjs",
    "check": "tsc --noEmit && node scripts/check-neutrality.cjs && node scripts/check-skills.cjs",
    "test:report": "node scripts/run-python.cjs test/report-pipeline.py --render",
    "verify": "npm run check && npm test && node scripts/run-python.cjs test/report-pipeline.py",
    "prune": "node scripts/prune.cjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
